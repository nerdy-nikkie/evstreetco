---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';
import Tbd from '~/components/Tbd.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { getPermalink } from '~/utils/permalinks';
import heathPhoto from '~/assets/images/heath.jpg';
import founderPlaceholder from '~/assets/images/founder-placeholder.svg';

const metadata = {
  title: 'About',
  description:
    'EV Street Co builds curbside EV charging stations in Chicago that the property owner owns outright, sets the rate on, and earns from.',
};
---

<Layout metadata={metadata}>
  <HeroText tagline="About" title="A contractor, not a charging network" />

  <Content>
    <Fragment slot="content">
      <p class="text-lg">
        Owning an EV in Chicago means a lot of guesswork about where to charge. Public stations fill up, late-night
        charging is a gamble, and without a garage the options are few. We started EV Street Co to change that.
      </p>
      <p class="mt-4 text-lg">
        Our model is simple. The property owner owns the charging station at the curb, sets their own price, and earns
        every time someone plugs in. We install it, keep the payments running, and take a dollar a session plus ten
        percent. That is the entire business.
      </p>
      <p class="mt-4 text-lg">
        We are not a charging network. We do not want to own equipment on your property or lock you into a ten-year site
        agreement. The station is yours. If you sell the building, it goes with it.
      </p>
    </Fragment>
  </Content>

  <WidgetWrapper id="founders" containerClass="max-w-7xl mx-auto">
    <Headline title="The people behind EV Street Co" tagline="Founders" />

    <div class="mx-auto mt-10 grid max-w-4xl gap-10 sm:grid-cols-2">
      <div class="text-center">
        <Image
          src={heathPhoto}
          alt="Heath, co-founder of EV Street Co"
          layout="constrained"
          class="mx-auto w-full max-w-xs rounded-lg shadow-sm"
        />
        <p class="mt-5 font-heading text-xl font-bold">Heath</p>
        <p class="text-muted">Founder</p>
        <p class="mt-3 text-base">
          <Tbd label="short bio" />
        </p>
      </div>

      <div class="text-center">
        <Image
          src={founderPlaceholder}
          alt="Placeholder photo for Nico, co-founder of EV Street Co"
          layout="constrained"
          class="mx-auto w-full max-w-xs rounded-lg shadow-sm"
        />
        <p class="mt-5 font-heading text-xl font-bold">Nico</p>
        <p class="text-muted">Co-founder</p>
        <p class="mt-3 text-base">
          <Tbd label="short bio" />
        </p>
      </div>
    </div>
  </WidgetWrapper>

  <Content
    isReversed
    title="What we will not do"
    items={[
      {
        title: 'Upgrade your service quietly',
        description:
          'If your panel is full, we tell you and quote it as separate work. You decide. No surprise line items after the fact.',
        icon: 'tabler:alert-triangle',
      },
      {
        title: 'Take a deposit on a property that is wrong for this',
        description:
          'No curb frontage, no parking area, or no spare panel capacity. We would rather say so on the first call.',
        icon: 'tabler:hand-stop',
      },
      {
        title: 'Do informal wiring',
        description:
          'Every mains connection is permitted with the city and inspected. There is no version of this where we skip that.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Lock you in',
        description:
          'No contract, no monthly fee, and no term. If you want to stop using our payments, the station is still yours.',
        icon: 'tabler:lock-open',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-alt dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <CallToAction actions={[{ variant: 'primary', text: 'Get an estimate', href: getPermalink('/#estimate') }]}>
    <Fragment slot="title">Find out what your curb is worth</Fragment>
    <Fragment slot="subtitle">
      Send us your address and we will take a look at your panel, your curb, and any rebates you may qualify for. If it
      turns out not to be a good fit, we will tell you honestly. 🙂
    </Fragment>
  </CallToAction>
</Layout>
