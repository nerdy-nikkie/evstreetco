---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import EstimateForm from '~/components/EstimateForm.astro';
import Tbd from '~/components/Tbd.astro';

import { BRAND } from '~/brand';

const metadata = {
  title: 'Contact',
  description: 'Reach EV Street Co about a curbside EV charging install at your Chicago property.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Contact"
    title="Talk to us"
    subtitle="The fastest way to get a real number is the estimate form. It gives us the address and the panel distance up front. If you would rather just ask a question, use the details below."
  />

  <WidgetWrapper containerClass="max-w-5xl mx-auto pt-0 md:pt-0 lg:pt-0">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-slate-900">
        <p class="font-heading text-sm font-bold uppercase tracking-wide text-secondary">Email</p>
        {
          BRAND.email ? (
            <a
              href={`mailto:${BRAND.email}`}
              class="mt-2 block break-words font-medium text-primary underline underline-offset-4"
            >
              {BRAND.email}
            </a>
          ) : (
            <p class="mt-2">
              <Tbd label="contact email" ref="Open item 9" />
            </p>
          )
        }
        <p class="mt-3 text-sm text-muted">We answer within a business day.</p>
      </div>

      <div class="rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-slate-900">
        <p class="font-heading text-sm font-bold uppercase tracking-wide text-secondary">Phone</p>
        {
          BRAND.phone ? (
            <a
              href={`tel:${BRAND.phone.replace(/[^+\d]/g, '')}`}
              class="mt-2 block font-medium text-primary underline underline-offset-4"
            >
              {BRAND.phone}
            </a>
          ) : (
            <p class="mt-2">
              773-234-4394
            </p>
          )
        }
        <p class="mt-3 text-sm text-muted">Commercial jobs move faster on a call.</p>
      </div>

    </div>

    <div class="mt-8 rounded-lg border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-slate-900">
      <p class="font-heading text-sm font-bold uppercase tracking-wide text-secondary">Service area</p>
      <p class="mt-2 text-muted">
        Chicago city limits. Curbside work sits in the public right-of-way, which means a city permit on top of the
        electrical permit, so we are staying inside one jurisdiction while we get the first installs done.
      </p>
    </div>
  </WidgetWrapper>

  <EstimateForm id="estimate" />
</Layout>
